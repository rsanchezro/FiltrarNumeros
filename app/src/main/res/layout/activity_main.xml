<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/arraysinFiltrarTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="Array_original"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:background="#C9F834"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arraysinFiltrarTV">

        <RadioButton
            android:id="@+id/filtrarPrimosRB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtrar Primos" />

        <RadioButton
            android:id="@+id/filtrarMagicosRB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtrar Magicos" />

        <RadioButton
            android:id="@+id/filtrarCapicuasRB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtrar Capicuas" />
    </RadioGroup>

    <TextView
        android:id="@+id/arrayfiltradoTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ArrayFiltrado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup"
        app:layout_constraintVertical_bias="0.22000003" />

</androidx.constraintlayout.widget.ConstraintLayout>